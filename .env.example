# PostgreSQL Database Connection
# Format: postgresql://[ПОЛЬЗОВАТЕЛЬ]:[ПАРОЛЬ]@[ХОСТ]:[ПОРТ]/[ИМЯ_БД]
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/contracts_db

# Example for local development:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contracts_db

# Example for remote database:
# DATABASE_URL=postgresql://user:password@your-host.com:5432/contracts_db
